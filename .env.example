# Copy this file to .env and fill in your key. Never commit .env.
NVIDIA_API_KEY=

# Copy the exact model ID from the Nemotron 3.5 Super VL page on build.nvidia.com
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Set to 0 to force offline mode even with a key
USE_NEMOTRON=1
